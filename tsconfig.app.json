{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "strict": true,
        "noEmit": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "types": []
    },
    "include": ["src/app/**/*", "src/games/**/types.ts", "src/games/settings.ts", "src/games/duration.ts"],
    "exclude": ["node_modules", "src/**/*.spec.ts"]
}
