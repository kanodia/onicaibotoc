{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PushAuth",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "Push",
      "Effect": "Allow",
      "Action": [
        "ecr:BatchCheckLayerAvailability",
        "ecr:BatchGetImage",
        "ecr:CompleteLayerUpload",
        "ecr:GetDownloadUrlForLayer",
        "ecr:InitiateLayerUpload",
        "ecr:PutImage",
        "ecr:UploadLayerPart"
      ],
      "Resource": "arn:aws:ecr:us-east-1:253040722768:repository/oc-onicai-bot"
    },
    {
      "Sid": "Restart",
      "Effect": "Allow",
      "Action": "ssm:SendCommand",
      "Resource": [
        "arn:aws:ec2:us-east-1:253040722768:instance/i-0198f9d466e519454",
        "arn:aws:ssm:us-east-1:253040722768:document/oc-onicai-bot-restart"
      ]
    },
    {
      "Sid": "RestartResult",
      "Effect": "Allow",
      "Action": "ssm:GetCommandInvocation",
      "Resource": "*"
    },
    {
      "Sid": "PublicUrl",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-1:253040722768:parameter/oc-onicai-bot/PUBLIC_URL"
    }
  ]
}
