#!/bin/sh
# Starts OnicaiBot on OpenChat's EC2 host, for the systemd unit `oc-onicai-bot`, installed as
# /usr/local/bin/oc-onicai-bot-start: pulls the image `oc-onicai-bot:latest` from ECR, writes the
# config from SSM Parameter Store's /oc-onicai-bot/* to /run, readable only by root, and runs the
# image with it. Its port, 3200 in the container, is 8085 on the host, as 8080 to 8084 are
# OpenChat's services'. Its games are kept in /var/lib/oc-onicai-bot, so a restart or a deploy
# doesn't end them. Logs go to CloudWatch, in /oc/onicai-bot, which is made beforehand.
#
# The image is pushed from this repo, and the host is shared with OpenChat's services, so the
# container gets only what the bot needs. It runs as `node`, with no capabilities and capped memory,
# on a network of its own that can't reach the instance's metadata, which would give it the
# instance role's credentials, and with them the other services' config.
set -eu
umask 077
REGION=us-east-1
IMAGE=253040722768.dkr.ecr.us-east-1.amazonaws.com/oc-onicai-bot:latest
DIR=/run/oc-onicai-bot
DATA=/var/lib/oc-onicai-bot
NETWORK=oc-onicai-bot
SUBNET=172.30.85.0/24

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "${IMAGE%%/*}"
docker pull "$IMAGE"

get() {
    aws ssm get-parameter --region "$REGION" --with-decryption --name "/oc-onicai-bot/$1" \
        --query Parameter.Value --output text
}
mkdir -p "$DIR"
# The keys span lines, so they're passed as values of their own rather than in the env file
get IDENTITY_PRIVATE > "$DIR/IDENTITY_PRIVATE"
get OC_PUBLIC > "$DIR/OC_PUBLIC"
{
    echo "IC_HOST=https://icp-api.io"
    echo "STORAGE_INDEX_CANISTER=rturd-qaaaa-aaaaf-aabaq-cai"
    echo "MINI_APP_SERVICE_URL=$(get MINI_APP_SERVICE_URL)"
} > "$DIR/env"

# The image runs as `node`, uid 1000, which writes the games
mkdir -p "$DATA"
chown 1000:1000 "$DATA"

# The rule is checked on every start, as a reboot clears it
docker network inspect "$NETWORK" > /dev/null 2>&1 || docker network create --subnet "$SUBNET" "$NETWORK" > /dev/null
iptables -C DOCKER-USER -s "$SUBNET" -d 169.254.169.254 -j DROP 2> /dev/null ||
    iptables -I DOCKER-USER -s "$SUBNET" -d 169.254.169.254 -j DROP

exec docker run --rm --name oc-onicai-bot \
    --network "$NETWORK" \
    --user 1000:1000 \
    --cap-drop ALL \
    --security-opt no-new-privileges \
    --memory 256m \
    --pids-limit 256 \
    --env-file "$DIR/env" \
    -e IDENTITY_PRIVATE="$(cat "$DIR/IDENTITY_PRIVATE")" \
    -e OC_PUBLIC="$(cat "$DIR/OC_PUBLIC")" \
    -v "$DATA":/data \
    -p 8085:3200 \
    --log-driver awslogs \
    --log-opt awslogs-region="$REGION" \
    --log-opt awslogs-group=/oc/onicai-bot \
    "$IMAGE"
